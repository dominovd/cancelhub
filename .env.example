# ──────────────────────────────────────────────────────────────────────────
# CancelHub environment variables
# Copy to .env.local and fill in. See docs/SETUP.md for where to get each.
# ──────────────────────────────────────────────────────────────────────────

# Supabase ─ Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by edge functions + trusted server actions.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend ─ API Keys (used directly for scheduled notification emails).
# Magic-link emails go through Supabase Auth SMTP which is configured
# separately in the Supabase dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@cancelhub.app

# Used for OAuth redirects + magic-link redirect_to + canonical URLs.
# Local: http://localhost:3000. Production: https://cancelhub.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
